#!/bin/sh
# voucher - pengelola voucher wifi (openNDS theme_voucher)
# Format: kode,down_kbps,up_kbps,kuota_down,kuota_up,menit,0

MASTER=/etc/voucher-wifi/vouchers.txt
ROLL=/tmp/ndslog/vouchers.txt

usage() {
  echo "Pemakaian:"
  echo "  voucher setup [NAMA_SSID]"
  echo "  voucher add MENIT [JUMLAH] [DOWN] [UP]"
  echo "  voucher list | save | sync"
  echo "Contoh: voucher add 60 10"
}

gen() { tr -dc 'A-Z0-9' </dev/urandom | head -c4; }
is_num() { case "$1" in ''|*[!0-9]*) return 1;; esac; return 0; }

cmd_sync() {
  mkdir -p /tmp/ndslog
  [ -f "$MASTER" ] && cp "$MASTER" "$ROLL" || : > "$ROLL"
  chmod 766 "$ROLL"
}

cmd_save() {
  [ -f "$ROLL" ] && cp "$ROLL" "$MASTER"
  return 0
}

cmd_add() {
  menit="$1"; jumlah="${2:-1}"; down="${3:-0}"; up="${4:-0}"
  is_num "$menit" && is_num "$jumlah" && is_num "$down" && is_num "$up" || { usage; exit 1; }
  [ -f "$ROLL" ] || cmd_sync
  i=0
  while [ "$i" -lt "$jumlah" ]; do
    kode="$(gen)-$(gen)"
    baris="$kode,$down,$up,0,0,$menit,0"
    echo "$baris" >> "$ROLL"
    echo "$baris" >> "$MASTER"
    echo "$kode  ($menit menit)"
    i=$((i+1))
  done
}

cmd_list() {
  [ -f "$ROLL" ] || cmd_sync
  cut -d, -f1,6 "$ROLL" | tr ',' ' ' | while read -r k m; do
    printf '%-12s %s menit\n' "$k" "$m"
  done
}

case "$1" in
  setup) shift; exec /usr/bin/voucher-setup "$@";;
  add)   shift; cmd_add "$@";;
  list)  cmd_list;;
  save)  cmd_save;;
  sync)  cmd_sync;;
  *)     usage;;
esac
