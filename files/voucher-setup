#!/bin/sh
# Buat SSID tamu terbuka + portal voucher openNDS
set -eu

SSID="${1:-WiFi-Voucher}"
IP=192.168.50.1

# Jangan mengasumsikan semua perangkat memakai radio0.
RADIO=""
for candidate in $(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
  disabled="$(uci -q get "wireless.$candidate.disabled" || echo 0)"
  if [ "$disabled" != "1" ]; then
    RADIO="$candidate"
    break
  fi
done
if [ -z "$RADIO" ]; then
  echo "Tidak ditemukan radio Wi-Fi yang aktif di konfigurasi UCI." >&2
  exit 1
fi

uci set network.br_guest=device
uci set network.br_guest.type='bridge'
uci set network.br_guest.name='br-guest'
uci set network.br_guest.bridge_empty='1'
uci set network.guest=interface
uci set network.guest.proto='static'
uci set network.guest.device='br-guest'
uci set network.guest.ipaddr="$IP"
uci set network.guest.netmask='255.255.255.0'

uci set dhcp.guest=dhcp
uci set dhcp.guest.interface='guest'
uci set dhcp.guest.start='10'
uci set dhcp.guest.limit='200'
uci set dhcp.guest.leasetime='1h'

uci set wireless.guest=wifi-iface
uci set wireless.guest.device="$RADIO"
uci set wireless.guest.mode='ap'
uci set wireless.guest.network='guest'
uci set wireless.guest.ssid="$SSID"
uci set wireless.guest.encryption='none'
uci set wireless.guest.isolate='1'

uci set firewall.guest=zone
uci set firewall.guest.name='guest'
uci -q delete firewall.guest.network
uci add_list firewall.guest.network='guest'
uci set firewall.guest.input='REJECT'
uci set firewall.guest.output='ACCEPT'
uci set firewall.guest.forward='REJECT'
uci set firewall.guest_wan=forwarding
uci set firewall.guest_wan.src='guest'
uci set firewall.guest_wan.dest='wan'
uci set firewall.guest_dns=rule
uci set firewall.guest_dns.name='Guest-DNS'
uci set firewall.guest_dns.src='guest'
uci set firewall.guest_dns.proto='tcp udp'
uci set firewall.guest_dns.dest_port='53'
uci set firewall.guest_dns.target='ACCEPT'
uci set firewall.guest_dhcp=rule
uci set firewall.guest_dhcp.name='Guest-DHCP'
uci set firewall.guest_dhcp.src='guest'
uci set firewall.guest_dhcp.proto='udp'
uci set firewall.guest_dhcp.dest_port='67'
uci set firewall.guest_dhcp.family='ipv4'
uci set firewall.guest_dhcp.target='ACCEPT'

uci set opennds.@opennds[0].enabled='1'
uci set opennds.@opennds[0].gatewayinterface='br-guest'
uci set opennds.@opennds[0].gatewayname="$SSID"
uci set opennds.@opennds[0].login_option_enabled='3'
uci set opennds.@opennds[0].themespec_path='/usr/lib/opennds/theme_voucher.sh'

# Commit per paket agar konfigurasi yang belum terkait tidak ikut ter-commit.
uci commit network
uci commit dhcp
uci commit wireless
uci commit firewall
uci commit opennds

chmod 744 /usr/lib/opennds/theme_voucher.sh
/usr/bin/voucher sync

/etc/init.d/network reload
/etc/init.d/dnsmasq restart
/etc/init.d/firewall restart
wifi reload

# Tunggu br-guest siap sebelum menyalakan openNDS.
n=0
while [ "$n" -lt 30 ]; do
  if ip addr show br-guest 2>/dev/null | grep -q 'inet '; then
    break
  fi
  sleep 2
  n=$((n + 1))
done
if ! ip addr show br-guest 2>/dev/null | grep -q 'inet '; then
  echo "br-guest belum memiliki alamat IP; openNDS tidak dijalankan." >&2
  exit 1
fi

/etc/init.d/opennds enable
/etc/init.d/opennds restart

echo "Selesai. SSID tamu: $SSID (radio: $RADIO). Buat voucher: voucher add 60 10"
